# LLM provider: openai (default) or anthropic.
LLM_PROVIDER=openai

# OpenAI API key for the Smart Inbox processor.
# Leave blank to use the rule-based fallback.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: use an OpenAI-compatible API (e.g., Kimi/Moonshot).
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# PROCESSOR_MODEL=kimi-latest

# Anthropic API key (set LLM_PROVIDER=anthropic to use Claude).
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# PROCESSOR_MODEL=claude-3-5-sonnet-20241022

# Optional: path to a custom system prompt template.
# LLM_SYSTEM_PROMPT_PATH=prompts/system.txt

# Local intelligence (learns from LLM outputs to avoid repeated API calls).
# LOCAL_INTELLIGENCE_ENABLED=true
# LOCAL_INTELLIGENCE_PATH=data/local_rules.json
# LOCAL_INTELLIGENCE_THRESHOLD=0.85
# LOCAL_INTELLIGENCE_MIN_HITS=3
# LOCAL_INTELLIGENCE_PRUNE_DAYS=30

# Rate limiting and batch processing.
# LLM_RATE_LIMIT_DELAY=0.2
# DAILY_DIGEST_BATCH_SIZE=50
# CHECKPOINT_PATH=data/checkpoint.json

# Gmail / Google Workspace OAuth credentials.
# Place credentials.json downloaded from Google Cloud Console in credentials/.
# The token.json file is created automatically on first run.
